 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "IconicFolders"
   VALUE "FileDescription", "IconicFolders"
   VALUE "FileVersion", "1.0.1"
   VALUE "ProductName", "IconicFolders"
   VALUE "ProductVersion", "1.0.1"
   VALUE "LegalCopyright", "Copyright (C) 2026 Benco"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
