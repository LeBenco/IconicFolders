#include <windows.h>
#include "resource.h"
1 ICON "../assets/icon.ico"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
 IDS_MENU "Folder icon"
 IDS_CHOOSE "Choose an icon…"
 IDS_RESET "Restore default icon"
 IDS_REFERENCE "Use the original icon"
 IDS_RESTART_FAILED "Windows Explorer could not be restarted automatically. IconicFolders is installed. You can restart Explorer later in Task Manager, or sign out and back in."
 IDS_RESTARTING "Restarting Windows Explorer…"
 IDS_RESTART_WAIT "Windows may wait up to 30 seconds for Explorer to close. This window will close automatically when the restart is complete."
 IDS_SAFETY_TITLE "Explorer integration disabled"
 IDS_SAFETY_BODY "Windows Explorer exited abnormally five times shortly after activating IconicFolders. As a precaution, its context menu has been disabled for your account.\n\nYou can continue using Windows. Install a corrected version before enabling this integration again."
 IDS_SAFETY_ENABLE "Enable integration again"
 IDS_COPY "Copy the icon into the folder"
 IDS_APPLY "Apply"
 IDS_TITLE_ONE "Folder icon — %s"
 IDS_TITLE_MANY "Folder icon — %s folders"
 IDS_ICO "Icons (*.ico)"
 IDS_CONFIRM_TITLE "Replace the copied icon?"
 IDS_CONFIRM_BODY "The following files will be replaced:\n\n%s"
 IDS_REPLACE "Replace"
 IDS_DELETE_TITLE "Delete the copied icon?"
 IDS_DELETE_BODY "The following files copied into these folders will be deleted:\n\n%s"
 IDS_DELETE "Delete"
 IDS_ERROR "The folder icon could not be changed."
 IDS_FAILURES "Some folders could not be updated:\n\n%s"
 IDS_HELP "Right-click a folder and select Folder icon.\n\nYou can also drop folders onto this program or run:\nIconicFolders.exe --choose <folder> […]\nIconicFolders.exe --reset <folder> […]"
 IDS_INVALID_ICO "Select a valid .ico file."
 IDS_ENCODING "This desktop.ini encoding cannot represent the icon path. Copy the icon into the folder instead."
 IDS_BUSY "This folder is being updated by another instance. Try again shortly."
 IDS_UNSUPPORTED_ENCODING "Windows does not support this desktop.ini encoding. No changes were made. Convert it to UTF-16 LE before changing the icon."
 IDS_TAB_IMAGE "Image or icon"
 IDS_TAB_FOLDER "Another folder"
 IDS_TAB_CATALOG "Icon catalogue"
 IDS_CANCEL "Cancel"
 IDS_IMAGE_COPY "Images must be converted to icons and stored in the folder"
 IDS_RESOLUTION "Resolution:"
 IDS_MAX_RESOLUTION "Max resolution:"
 IDS_ADD_SOURCE "Add EXE/DLL…"
 IDS_APPLICATION_FILES "Applications and libraries (*.exe; *.dll)"
 IDS_SOURCES "Sources"
 IDS_REMOVE_SOURCE "Remove from list"
 IDS_REMOVE_HINT "Trash icon or Delete: remove from list"
 IDS_THIS_FOLDER "This folder"
 IDS_BACK "Back"
 IDS_UP "Up"
 IDS_GO "Go"
 IDS_LOADING "Loading…"
 IDS_INVALID_SOURCE "This selection could not be loaded."
 IDS_NO_ICONS "This source contains no icons."
 IDS_SOURCE_ERROR "The source could not be loaded."
 IDS_COLLECTION_WINDOWS "Windows"
 IDS_COLLECTION_EXPLORER "Explorer"
 IDS_COLLECTION_DEVICES "Devices"
 IDS_COLLECTION_CLASSIC "Classic"
 IDS_IMAGE_FILES "Images and icons (*.ico; *.png; *.jpg; *.jpeg; *.bmp)"
 IDS_EMBED_UNAVAILABLE "The embedded view is unavailable. Open the native picker instead."
 IDS_BROWSE "Browse…"
 IDS_RESOURCE_REFERENCE "Embedded icons are used from their original file."

END
LANGUAGE LANG_FRENCH, SUBLANG_FRENCH
STRINGTABLE
BEGIN
 IDS_MENU "Icône du dossier"
 IDS_CHOOSE "Choisir une icône…"
 IDS_RESET "Rétablir l’icône par défaut"
 IDS_REFERENCE "Utiliser l’icône d’origine"
 IDS_RESTART_FAILED "L’Explorateur Windows n’a pas pu être redémarré automatiquement. IconicFolders est installé. Vous pouvez redémarrer l’Explorateur plus tard depuis le Gestionnaire des tâches, ou vous déconnecter puis vous reconnecter."
 IDS_RESTARTING "Redémarrage de l’Explorateur Windows…"
 IDS_RESTART_WAIT "Windows peut attendre jusqu’à 30 secondes pour fermer l’Explorateur. Cette fenêtre se fermera automatiquement une fois le redémarrage terminé."
 IDS_SAFETY_TITLE "Intégration à l’Explorateur désactivée"
 IDS_SAFETY_BODY "L’Explorateur s’est arrêté anormalement cinq fois peu après l’activation d’IconicFolders. Par précaution, son menu contextuel a été désactivé pour votre compte.\n\nVous pouvez continuer à utiliser Windows. Installez une version corrigée avant de réactiver cette intégration."
 IDS_SAFETY_ENABLE "Réactiver l’intégration"
 IDS_COPY "Copier l’icône dans le dossier"
 IDS_APPLY "Appliquer"
 IDS_TITLE_ONE "Icône du dossier — %s"
 IDS_TITLE_MANY "Icône du dossier — %s dossiers"
 IDS_ICO "Icônes (*.ico)"
 IDS_CONFIRM_TITLE "Remplacer l’icône recopiée ?"
 IDS_CONFIRM_BODY "Les fichiers suivants vont être remplacés :\n\n%s"
 IDS_REPLACE "Remplacer"
 IDS_DELETE_TITLE "Supprimer l’icône recopiée ?"
 IDS_DELETE_BODY "Les fichiers suivants, recopiés dans ces dossiers, vont être supprimés :\n\n%s"
 IDS_DELETE "Supprimer"
 IDS_ERROR "L’icône du dossier n’a pas pu être modifiée."
 IDS_FAILURES "Certains dossiers n’ont pas pu être modifiés :\n\n%s"
 IDS_HELP "Faites un clic droit sur un dossier, puis choisissez Icône du dossier.\n\nVous pouvez aussi déposer des dossiers sur ce programme ou lancer :\nIconicFolders.exe --choose <dossier> […]\nIconicFolders.exe --reset <dossier> […]"
 IDS_INVALID_ICO "Choisissez un fichier .ico valide."
 IDS_ENCODING "L’encodage de ce desktop.ini ne permet pas d’écrire le chemin de l’icône. Recopiez plutôt l’icône dans le dossier."
 IDS_BUSY "Une autre instance modifie ce dossier. Réessayez dans un instant."
 IDS_UNSUPPORTED_ENCODING "Windows ne prend pas en charge l’encodage de ce desktop.ini. Aucune modification n’a été faite. Convertissez-le en UTF-16 LE avant de changer l’icône."
 IDS_TAB_IMAGE "Image ou icône"
 IDS_TAB_FOLDER "Autre répertoire"
 IDS_TAB_CATALOG "Catalogue d’icônes"
 IDS_CANCEL "Annuler"
 IDS_IMAGE_COPY "Les images doivent être converties en icones et stockées dans le répertoire"
 IDS_RESOLUTION "Résolution :"
 IDS_MAX_RESOLUTION "Résolution max :"
 IDS_ADD_SOURCE "Ajouter une EXE/DLL…"
 IDS_APPLICATION_FILES "Applications et bibliothèques (*.exe; *.dll)"
 IDS_SOURCES "Sources"
 IDS_REMOVE_SOURCE "Retirer de la liste"
 IDS_REMOVE_HINT "Poubelle ou Suppr : retirer de la liste"
 IDS_THIS_FOLDER "Ce répertoire"
 IDS_BACK "Retour"
 IDS_UP "Monter"
 IDS_GO "Aller"
 IDS_LOADING "Chargement…"
 IDS_INVALID_SOURCE "Impossible de charger cette sélection."
 IDS_NO_ICONS "Cette source ne contient aucune icône."
 IDS_SOURCE_ERROR "Impossible de charger la source."
 IDS_COLLECTION_WINDOWS "Windows"
 IDS_COLLECTION_EXPLORER "Explorateur"
 IDS_COLLECTION_DEVICES "Appareils"
 IDS_COLLECTION_CLASSIC "Classiques"
 IDS_IMAGE_FILES "Images et icônes (*.ico; *.png; *.jpg; *.jpeg; *.bmp)"
 IDS_EMBED_UNAVAILABLE "La vue intégrée est indisponible. Ouvrez le sélecteur natif."
 IDS_BROWSE "Parcourir…"
 IDS_RESOURCE_REFERENCE "Les icônes embarquées sont utilisées depuis leur fichier d’origine."

END
