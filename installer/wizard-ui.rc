// NSIS's documented IDD_INST controls; the standard inner pages stay native.
#include <windows.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

105 DIALOGEX 0, 0, 439, 228
STYLE DS_SETFONT | DS_FIXEDSYS | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "IconicFolders"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", 1034, "Static", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS, 109, 0, 330, 193
    CONTROL "", 1025, "Static", SS_BITMAP | WS_CHILD | WS_VISIBLE, 0, 0, 109, 108
    CONTROL "IconicFolders", 1050, "Static", SS_CENTER | SS_NOPREFIX | WS_CHILD | WS_VISIBLE, 6, 112, 97, 22
    CONTROL "", 1051, "Static", SS_CENTER | SS_NOPREFIX | WS_CHILD | WS_VISIBLE, 6, 136, 97, 28
    CONTROL "", 1037, "Static", SS_LEFT | WS_CHILD | WS_VISIBLE, 124, 8, 300, 16
    CONTROL "", 1038, "Static", SS_LEFT | WS_CHILD | WS_VISIBLE, 124, 27, 300, 12
    CONTROL "", 1039, "Static", SS_LEFT | WS_CHILD, 0, 0, 0, 0
    CONTROL "", 1018, "Static", SS_LEFT | WS_CHILD, 124, 44, 300, 140
    CONTROL "", 1035, "Static", SS_ETCHEDHORZ | WS_CHILD | WS_VISIBLE, 0, 193, 439, 1
    CONTROL "", 1045, "Static", SS_ETCHEDHORZ | WS_CHILD, 0, 193, 439, 1
    CONTROL "", 1028, "Static", SS_LEFT | WS_CHILD | WS_VISIBLE, 7, 207, 180, 12
    CONTROL "", 1256, "Static", SS_LEFT | WS_CHILD | WS_VISIBLE, 7, 207, 180, 12
    PUSHBUTTON "< &Back", 3, 232, 204, 60, 16
    DEFPUSHBUTTON "&Next >", IDOK, 294, 204, 60, 16
    PUSHBUTTON "Cancel", IDCANCEL, 370, 204, 60, 16
END
